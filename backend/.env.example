# All of these are optional. The app runs without a .env file at all.
# OPENAI_API_KEY is only needed for the CV extraction and analysis endpoints.
# The GOOGLE_* values are only needed for Drive and Sheets sync.
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/drive/callback
